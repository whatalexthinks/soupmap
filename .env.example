# Copy to .env.local for local dev. Never commit real keys.
# In Cloudflare Pages: Settings → Environment variables (Production + Preview).

# Browser-restricted Google key: Map Tiles API for 3D, Maps JavaScript API for
# interactive Street View, and Places UI Kit for restaurant photos/details.
# Enable these services and allow deployed HTTP referrers (see docs/catalog-discovery.md).
# Leave empty to run with the GSI fallback globe.
VITE_GOOGLE_MAPS_KEY=

# Cloudflare Web Analytics site token (the "token" value from the JS snippet).
# Leave empty to omit the analytics script entirely.
VITE_CF_ANALYTICS_TOKEN=

# Public origin, used for canonical URLs, Open Graph tags and the sitemap.
VITE_SITE_URL=https://soupmap.com

# ── Recipe ingredient "Buy" links (optional) ───────────────────────────────
# With neither set, recipes show no shopping links. Links are rel="sponsored nofollow"
# and the ingredients section shows the disclosure each programme requires.
# Amazon Associates tracking ID, e.g. soupmap-20 (and the store, if not amazon.com).
VITE_AMAZON_ASSOCIATES_TAG=
VITE_AMAZON_DOMAIN=www.amazon.com
# An https Instacart (or Impact tracking) link with {query} where the search goes.
VITE_INSTACART_LINK_TEMPLATE=

# ── IndexNow (server; optional) ────────────────────────────────────────────
# 8–128 letters, digits or dashes; served at /<key>.txt. Needs migrations/003_indexnow.sql.
# Each production start submits sitemap URLs that are new or changed. INDEXNOW_AUTO=off stops that.
INDEXNOW_KEY=
INDEXNOW_AUTO=
# At least 24 characters. Lets the owner POST /api/indexnow with "Authorization: Bearer <token>".
INDEXNOW_ADMIN_TOKEN=
