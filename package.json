{
  "name": "soupmap",
  "version": "0.1.0",
  "private": true,
  "description": "A worldwide soup atlas for curious travelers, starting with a Japan pilot.",
  "type": "module",
  "engines": {
    "node": ">=20.19"
  },
  "scripts": {
    "dev": "tsx server/index.ts",
    "start": "NODE_ENV=production tsx server/index.ts",
    "build": "npm run data:plateau -- --soft && npm run validate && tsc --noEmit && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "validate": "npm run validate:homepage && node --import tsx scripts/validate-shops.ts",
    "validate:homepage": "node --import tsx scripts/validate-homepage.ts",
    "data:plateau": "node --import tsx scripts/fetch-plateau-catalog.ts",
    "discover": "node --import tsx scripts/discover-shops.ts",
    "data:romanize": "node --import tsx scripts/romanize-catalog.ts",
    "data:municipalities": "node --import tsx scripts/build-municipalities.ts",
    "assets:social": "node scripts/generate-social-card.mjs",
    "photos:recipes": "node --import tsx scripts/fetch-recipe-photos.ts",
    "licenses": "node --import tsx scripts/print-licenses.ts",
    "test": "node --import tsx --test tests/*.test.ts",
    "test:preview": "node tests/browser/preview.mjs",
    "test:navigation": "node tests/browser/navigation.mjs",
    "test:streetview": "node tests/browser/streetview.mjs",
    "test:streetview:live": "node tests/browser/streetview.mjs --live"
  },
  "dependencies": {
    "@clerk/express": "2.1.80",
    "@clerk/react": "6.17.8",
    "@clerk/shared": "4.40.0",
    "@clerk/themes": "2.4.57",
    "@fontsource-variable/fraunces": "5.3.0",
    "@fontsource-variable/instrument-sans": "5.3.0",
    "@fontsource-variable/space-grotesk": "5.3.0",
    "@fontsource/noto-sans-jp": "5.3.0",
    "@googlemaps/js-api-loader": "2.1.3",
    "@resvg/resvg-js": "2.6.2",
    "@sparkjsdev/spark": "2.3.1",
    "@types/cors": "2.8.19",
    "@types/express": "5.0.6",
    "@types/google.maps": "3.66.7",
    "@types/kuromoji": "0.1.3",
    "@types/pg": "8.23.1",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "cesium": "1.146.0",
    "cors": "2.8.6",
    "express": "5.3.0",
    "fontkit": "2.0.4",
    "http-proxy-middleware": "4.2.0",
    "kuromoji": "0.1.2",
    "pg": "8.23.1",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "sirv": "3.0.2",
    "sirv-cli": "3.0.1",
    "supercluster": "9.1.0",
    "three": "0.186.1",
    "tsx": "4.23.15",
    "wanakana": "5.3.1",
    "wouter": "3.13.0"
  },
  "devDependencies": {
    "@types/node": "25.9.9",
    "@types/supercluster": "7.1.3",
    "@types/three": "0.186.0",
    "happy-dom": "21.0.3",
    "playwright": "1.64.1",
    "typescript": "6.0.3",
    "vite": "8.3.2",
    "zod": "4.6.5"
  }
}
