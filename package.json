{
  "name": "soupmap",
  "version": "0.1.0",
  "private": true,
  "description": "A photorealistic 3D map of Japan's best soup shops: ramen, udon, soba, oden.",
  "type": "module",
  "engines": {
    "node": ">=20.19"
  },
  "scripts": {
    "dev": "vite",
    "build": "npm run data:plateau -- --soft && npm run validate && tsc --noEmit && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "validate": "node --import tsx scripts/validate-shops.ts",
    "data:plateau": "node --import tsx scripts/fetch-plateau-catalog.ts",
    "discover": "node --import tsx scripts/discover-shops.ts",
    "licenses": "node --import tsx scripts/print-licenses.ts",
    "test": "node --import tsx --test tests/*.test.ts"
  },
  "dependencies": {
    "@fontsource-variable/fraunces": "5.3.0",
    "@fontsource-variable/instrument-sans": "5.3.0",
    "@fontsource/noto-sans-jp": "5.3.0",
    "@sparkjsdev/spark": "2.3.1",
    "cesium": "1.146.0",
    "supercluster": "9.1.0",
    "three": "0.186.1"
  },
  "devDependencies": {
    "@types/node": "25.9.9",
    "@types/supercluster": "7.1.3",
    "@types/three": "0.186.0",
    "happy-dom": "21.0.3",
    "tsx": "4.23.15",
    "typescript": "6.0.3",
    "vite": "8.3.2",
    "vite-plugin-static-copy": "4.1.1",
    "zod": "4.6.5"
  }
}
