{
  "name": "soupmap",
  "version": "0.1.0",
  "private": true,
  "description": "A worldwide soup atlas for curious travelers, starting with a Japan pilot.",
  "type": "module",
  "engines": {
    "node": ">=20.19"
  },
  "scripts": {
    "dev": "vite",
    "start": "sirv dist --host 0.0.0.0 --port ${PORT:-5000}",
    "build": "npm run data:plateau -- --soft && npm run validate && tsc --noEmit && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "validate": "node --import tsx scripts/validate-shops.ts",
    "data:plateau": "node --import tsx scripts/fetch-plateau-catalog.ts",
    "discover": "node --import tsx scripts/discover-shops.ts",
    "data:romanize": "node --import tsx scripts/romanize-catalog.ts",
    "assets:social": "node scripts/generate-social-card.mjs",
    "licenses": "node --import tsx scripts/print-licenses.ts",
    "test": "node --import tsx --test tests/*.test.ts"
  },
  "dependencies": {
    "@fontsource-variable/fraunces": "5.3.0",
    "@fontsource-variable/instrument-sans": "5.3.0",
    "@fontsource/noto-sans-jp": "5.3.0",
    "@googlemaps/js-api-loader": "2.1.3",
    "@resvg/resvg-js": "2.6.2",
    "@sparkjsdev/spark": "2.3.1",
    "@types/google.maps": "3.66.7",
    "@types/kuromoji": "0.1.3",
    "cesium": "1.146.0",
    "fontkit": "2.0.4",
    "kuromoji": "0.1.2",
    "sirv": "3.0.2",
    "sirv-cli": "3.0.1",
    "supercluster": "9.1.0",
    "three": "0.186.1",
    "wanakana": "5.3.1"
  },
  "devDependencies": {
    "@types/node": "25.9.9",
    "@types/supercluster": "7.1.3",
    "@types/three": "0.186.0",
    "happy-dom": "21.0.3",
    "tsx": "4.23.15",
    "typescript": "6.0.3",
    "vite": "8.3.2",
    "zod": "4.6.5"
  }
}
