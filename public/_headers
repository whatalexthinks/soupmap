# Cloudflare Pages response headers.
# Hashed bundles and the versioned Cesium folder never change: cache forever.
/assets/*
  Cache-Control: public, max-age=31536000, immutable

/cesium/*
  Cache-Control: public, max-age=31536000, immutable

/*
  X-Content-Type-Options: nosniff
  X-Frame-Options: SAMEORIGIN
  # Keeps the origin on cross-origin requests: Google key referrer restrictions depend on it.
  Referrer-Policy: strict-origin-when-cross-origin
  # geolocation=(self): the "Nearest me" sort asks for location after an explicit choice.
  Permissions-Policy: camera=(), microphone=(), geolocation=(self), payment=(), usb=()

/catalog/*
  Cache-Control: public, max-age=300, s-maxage=3600, stale-while-revalidate=86400

/city/*
  Cache-Control: public, max-age=300, s-maxage=3600, stale-while-revalidate=86400

/sitemap.xml
  Cache-Control: public, max-age=300, s-maxage=3600

/robots.txt
  Cache-Control: public, max-age=300, s-maxage=3600

/llms.txt
  Cache-Control: public, max-age=300, s-maxage=3600

/api/*
  Cache-Control: no-store
  X-Robots-Tag: noindex, nofollow
